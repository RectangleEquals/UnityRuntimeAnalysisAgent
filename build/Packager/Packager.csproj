<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time tool: turns the BepInEx 5 plugin's build output into the release package (never shipped). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UnityRuntimeAnalysisAgent.Packaging</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\external\protocol\protocol\csharp\UnityLudometry.Protocol\UnityLudometry.Protocol.csproj" />
  </ItemGroup>
</Project>
