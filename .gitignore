# Build output
bin/
obj/
dist/
artifacts/
*.binlog

# Crash dumps, logs and merge leftovers
*.stackdump
*.dmp
*.log
*.orig
*.rej

# OS files
Thumbs.db
desktop.ini
.DS_Store

# Secrets (never commit)
.env
*.pfx
*.snk

# IDE / user files
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user

# Machine-specific settings (never commit)
Directory.Build.local.props
*.local.props
*.local.json


# Unity projects the overlay asset build creates (tools/OverlayAssets/build.ps1)
tools/OverlayAssets/Projects/

# Overlay binaries: released as GitHub release assets and locked by assets/overlay/release.json (the build downloads
# them); the source fonts are fetched by tools/OverlayAssets/fonts.py
assets/overlay/bundles/*.bundle
assets/overlay/icons/*.png
tools/OverlayAssets/Source/Overlay/Fonts/*.ttf
