<Project Sdk="Microsoft.NET.Sdk">
  <!-- A dependency that is deliberately NOT deployed next to the tests: the "Broken" assembly needs it, so loading some of
       Broken's types fails the way a mod with a missing dependency fails inside a game. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3" />
    <PackageReference Remove="xunit.runner.visualstudio" />
    <PackageReference Remove="Microsoft.NET.Test.Sdk" />
    <Using Remove="Xunit" />
  </ItemGroup>
</Project>
