{
  "name": "default",
  "tokens": {
    "color": {
      "bg": "#0F1218F2",
      "surface": "#171B24",
      "surface-2": "#1F2430",
      "surface-3": "#2A3040",
      "border": "#34405A",
      "text": "#E6E9F0",
      "text-dim": "#8C95A8",
      "accent": "#4FC3FF",
      "accent-dim": "#1E5C80",
      "ok": "#5BD08A",
      "warn": "#FFB020",
      "error": "#FF5A5A",
      "mutation": "#E08CFF",
      "focus": "#FFFFFF",
      "transparent": "transparent"
    },
    "space": { "0": "0", "1": "2", "2": "4", "3": "8", "4": "12", "5": "16", "6": "24" },
    "radius": { "sm": "3", "md": "6", "lg": "10", "pill": "999" },
    "size": { "small": "10", "body": "12", "large": "24", "row": "20", "control": "22", "arrow": "48" },
    "motion": { "fast": "120", "normal": "200", "slow": "320", "toast": "4000" }
  },
  "classes": {
    "panel": { "background-color": "$color.bg", "border-color": "$color.border", "border-width": "1", "border-radius": "$radius.lg", "padding": "$space.3" },
    "stack": {},
    "text": { "color": "$color.text", "font": "pixel", "font-size": "$size.body" },
    "icon": { "color": "$color.text", "width": "16", "height": "16" },
    "image": {},
    "effect": { "border-radius": "$radius.md" },
    "separator": { "height": "1", "background-color": "$color.border", "margin": "$space.2 0" },
    "button": { "flex-shrink": "0", "white-space": "nowrap", "flex-direction": "row", "align-items": "center", "justify-content": "center", "height": "$size.control", "padding": "0 $space.3", "background-color": "$color.surface-2", "border-color": "$color.border", "border-width": "1", "border-radius": "$radius.sm", "color": "$color.text", "font": "pixel", "font-size": "$size.body" },
    "button:hover": { "background-color": "$color.surface-3", "border-color": "$color.accent-dim" },
    "button:active": { "background-color": "$color.accent-dim" },
    "button:focus": { "border-color": "$color.focus" },
    "button:disabled": { "color": "$color.text-dim", "opacity": "0.6" },
    "toggle": { "flex-direction": "row", "align-items": "center", "height": "$size.control", "color": "$color.text", "font": "pixel", "font-size": "$size.body" },
    "toggle:checked": { "color": "$color.accent" },
    "toggle:focus": { "border-color": "$color.focus" },
    "slider": { "height": "$size.control", "color": "$color.accent" },
    "dropdown": { "height": "$size.control", "background-color": "$color.surface-2", "border-color": "$color.border", "border-width": "1", "border-radius": "$radius.sm", "padding": "0 $space.3", "color": "$color.text", "font": "pixel", "font-size": "$size.body" },
    "textField": { "height": "$size.control", "background-color": "$color.surface", "border-color": "$color.border", "border-width": "1", "border-radius": "$radius.sm", "padding": "0 $space.2", "color": "$color.text", "font": "mono", "font-size": "$size.body" },
    "textField:focus": { "border-color": "$color.accent" },
    "list": { "flex-grow": "1", "background-color": "$color.surface", "border-radius": "$radius.sm" },
    "tree": { "flex-grow": "1", "background-color": "$color.surface", "border-radius": "$radius.sm" },
    "table": { "flex-grow": "1", "background-color": "$color.surface", "border-radius": "$radius.sm" },
    "tabs": { "flex-direction": "row", "border-color": "$color.border" },
    "progress": { "height": "6", "background-color": "$color.surface-3", "border-radius": "$radius.pill", "color": "$color.accent" },
    "sparkline": { "height": "24", "color": "$color.accent" },
    "badge": { "flex-shrink": "0", "white-space": "nowrap", "padding": "0 $space.2", "height": "14", "background-color": "$color.accent-dim", "border-radius": "$radius.pill", "color": "$color.text", "font": "pixel", "font-size": "$size.small" },

    "row": { "flex-direction": "row", "align-items": "center", "min-height": "$size.row", "padding": "0 $space.2" },
    "row:hover": { "background-color": "$color.surface-2" },
    "row:checked": { "background-color": "$color.accent-dim" },
    "tab": { "flex-shrink": "0", "white-space": "nowrap", "height": "$size.control", "padding": "0 $space.3", "color": "$color.text-dim", "font": "pixel", "font-size": "$size.body" },
    "tab:hover": { "color": "$color.text" },
    "tab:checked": { "color": "$color.accent", "border-color": "$color.accent" },
    "heading": { "font": "heading", "font-size": "$size.large", "color": "$color.accent", "margin-bottom": "$space.2", "flex-shrink": "0" },
    "label": { "color": "$color.text-dim", "font": "pixel", "font-size": "$size.body" },
    "value": { "color": "$color.text", "font": "mono", "font-size": "$size.body" },
    "dim": { "color": "$color.text-dim" },
    "ok": { "color": "$color.ok" },
    "warn": { "color": "$color.warn" },
    "error": { "color": "$color.error" },
    "mutation": { "color": "$color.mutation" },
    "danger": { "background-color": "#6E1F1F", "border-color": "$color.error" },
    "danger:hover": { "background-color": "#8C2626" },
    "toast": { "flex-direction": "row", "align-items": "center", "padding": "$space.2 $space.3", "margin-top": "$space.2", "background-color": "$color.surface-2", "border-color": "$color.border", "border-width": "1", "border-radius": "$radius.md", "max-width": "360" },
    "card": { "background-color": "$color.surface", "border-color": "$color.accent-dim", "border-width": "1", "border-radius": "$radius.md", "padding": "$space.3" },
    "arrow": { "width": "$size.arrow", "height": "$size.arrow" }
  },
  "effects": {
    "header": { "kind": "water", "colorA": "#0F1218", "colorB": "#1E5C80", "pixels": "48", "speed": "0.6" },
    "estop": { "kind": "fire", "colorA": "#3A0A0A", "colorB": "#FF5A5A", "pixels": "32", "speed": "1.2" },
    "idle": { "kind": "plasma", "colorA": "#0F1218", "colorB": "#34405A", "pixels": "64", "speed": "0.3" }
  }
}
