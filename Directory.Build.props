<Project>
  <!-- Machine-specific settings (never committed). See build/Local.props.example. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Release builds don't depend on where the repository is checked out (source paths are mapped to /_/), so every
         checkout builds byte-identical assemblies. Debug builds keep real paths for debugging. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <!-- Shipped assemblies spell out their usings; tool projects enable implicit usings themselves. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>RectangleEquals</Authors>
    <Copyright>Copyright (c) 2026 RectangleEquals</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RectangleEquals/UnityRuntimeAnalysisAgent</RepositoryUrl>
    <!-- The loader needs a numeric plugin version (VersionPrefix); the full version carries the suffix. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <!-- Shipped assemblies (netstandard2.0): modern C# via source-only polyfills, no runtime dependencies. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
