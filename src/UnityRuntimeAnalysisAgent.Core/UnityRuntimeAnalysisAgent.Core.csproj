<Project Sdk="Microsoft.NET.Sdk">
  <!-- All agent logic. No UnityEngine and no loader references (enforced by an architecture test). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>UnityRuntimeAnalysisAgent.Core</RootNamespace>
    <ProtocolProject>$(MSBuildThisFileDirectory)..\..\external\protocol\protocol\csharp\UnityLudometry.Protocol\UnityLudometry.Protocol.csproj</ProtocolProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-only: HarmonyX is provided by the loader at runtime. -->
    <PackageReference Include="HarmonyX" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared protocol (git submodule). UnityLudometry.Protocol.dll ships with the plugin; it has no dependencies. -->
    <ProjectReference Include="$(ProtocolProject)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnityRuntimeAnalysisAgent.Core.Tests" />
  </ItemGroup>

  <Target Name="CheckProtocolSubmodule" BeforeTargets="PrepareForBuild;CollectPackageReferences" Condition="!Exists('$(ProtocolProject)')">
    <Error Text="The protocol submodule is missing (external/protocol). Run: git submodule update --init --recursive" />
  </Target>
</Project>
