<Project Sdk="Microsoft.NET.Sdk">
  <!-- The in-game overlay: views, themes, the flex layout engine, focus, motion and assets; renderers follow. Optional at runtime. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>UnityRuntimeAnalysisAgent.Overlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Core\UnityRuntimeAnalysisAgent.Core.csproj" />
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Unity\UnityRuntimeAnalysisAgent.Unity.csproj" />
    <PackageReference Include="UnityEngine.Modules" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Compile-only: HarmonyX is provided by the loader at runtime. -->
    <PackageReference Include="HarmonyX" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
