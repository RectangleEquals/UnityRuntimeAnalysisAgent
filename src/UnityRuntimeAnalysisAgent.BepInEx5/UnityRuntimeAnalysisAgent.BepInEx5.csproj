<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx 5 loader shim: the plugin entry point, config binding, ILoaderApi implementation. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>UnityRuntimeAnalysisAgent.BepInEx5</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Core\UnityRuntimeAnalysisAgent.Core.csproj" />
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Unity\UnityRuntimeAnalysisAgent.Unity.csproj" />
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Overlay\UnityRuntimeAnalysisAgent.Overlay.csproj" />
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Api\UnityRuntimeAnalysisAgent.Api.csproj" />
    <!-- Shipped next to the plugin but never referenced: the overlay loads it by name only when it picks UI Toolkit. -->
    <ProjectReference Include="..\UnityRuntimeAnalysisAgent.Overlay.UIToolkit\UnityRuntimeAnalysisAgent.Overlay.UIToolkit.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
    <!-- Compile-only: BepInEx (brings BepInEx.BaseLib = BepInEx.dll) and HarmonyX are provided by the installed loader. -->
    <PackageReference Include="BepInEx.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Import Project="..\..\build\Package.targets" />

  <!-- The plugin attribute needs the version as a constant, and BepInEx needs it numeric: generate it from VersionPrefix. -->
  <Target Name="GenerateAgentBuildConstants" BeforeTargets="CoreCompile" Inputs="$(MSBuildProjectFullPath)" Outputs="$(IntermediateOutputPath)AgentBuild.g.cs">
    <PropertyGroup>
      <AgentBuildFile>$(IntermediateOutputPath)AgentBuild.g.cs</AgentBuildFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(AgentBuildFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="// Generated by the build. Do not edit.;namespace UnityRuntimeAnalysisAgent.BepInEx5%3B;/// &lt;summary&gt;Build constants.&lt;/summary&gt;;internal static class AgentBuild;{;    /// &lt;summary&gt;The numeric plugin version BepInEx needs.&lt;/summary&gt;;    public const string PluginVersion = &quot;$(VersionPrefix)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(AgentBuildFile)" />
      <FileWrites Include="$(AgentBuildFile)" />
    </ItemGroup>
  </Target>
</Project>
